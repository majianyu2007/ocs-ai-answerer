# 复制为 .env 后填写；环境变量优先级高于 config.toml
# 程序启动时会自动读取当前目录下的 .env，docker compose 也会读取该文件

# ===== AI 接口（必填：API Key 与模型）=====
OCS_AI_PROVIDER=openai
OCS_AI_BASE_URL=https://api.openai.com/v1
OCS_AI_API_KEY=sk-your-api-key
OCS_AI_MODEL=gpt-4o-mini
# OCS_AI_ENDPOINT=
# OCS_AI_TEMPERATURE=0.1
# OCS_AI_MAX_TOKENS=1024
# OCS_AI_TIMEOUT_SECS=25
# OCS_AI_MAX_RETRIES=1
# 是否发送图片题图片（模型不支持图片时设为 false）
# OCS_AI_VISION=true
# 先分析再作答（推理模型可设为 false 节省费用）
# OCS_STEP_BY_STEP=true

# ===== 答案缓存 =====
# OCS_CACHE_ENABLED=true
# OCS_CACHE_FILE=data/cache.jsonl

# ===== 服务 =====
# OCS_SERVER_HOST=127.0.0.1
# OCS_SERVER_PORT=3000
# OCS_LOG_LEVEL=info
# OCS_ACCESS_TOKEN=
# OCS_PUBLIC_URL=
# OCS_CONFIG=config.toml
